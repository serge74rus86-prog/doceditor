<UserControl x:Class="PilotMarkdownModule.Views.MarkdownEditorWithTreeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:views="clr-namespace:PilotMarkdownModule.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <!-- Иконка файла -->
        <DrawingImage x:Key="FileIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF0078D4">
                        <GeometryDrawing.Geometry>
                            <PathGeometry FillRule="Nonzero" Figures="M3,14L3,14 13,14 13,5.5 8.531,1.031 3,1.031z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <PathGeometry FillRule="Nonzero" Figures="M8,2L8,6 12,6 12,13 4,13 4,2 M9,2.75L9,5 11.25,5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        
        <!-- Иконка копирования -->
        <DrawingImage x:Key="CopyIcon" RenderOptions.EdgeMode="Aliased">
            <DrawingImage.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <DrawingBrush Stretch="None" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#FF0078D4">
                                        <GeometryDrawing.Geometry>
                                            <PathGeometry FillRule="Nonzero" Figures="M5,5 L14,5 14,14 5,14 5,5 Z M3,3 L12,3 12,12 3,12 3,3 Z" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5">
            <TextBlock Text="ℹ️ EasyMDE имеет встроенную панель форматирования" 
                      FontStyle="Italic" 
                      Foreground="#666666"
                      VerticalAlignment="Center"
                      Margin="8,0"/>
            <Separator/>
            <ToggleButton x:Name="PreviewToggle"
                          Content="👁️ Предпросмотр"
                          IsChecked="{Binding IsPreviewEnabled, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          ToolTip="Включите для просмотра HTML, выключите для редактирования в EasyMDE"
                          Padding="8,4"
                          Margin="4,0"/>
            <Separator/>
            <Button Content="📋 Копировать HTML" 
                    Command="{Binding CopyHtmlCommand}"
                    ToolTip="Копировать HTML в буфер обмена"
                    Padding="8,4"
                    Margin="4,0"/>
            <Button Content="📄 Экспорт в PDF" 
                    Click="ExportToPdf_Click"
                    ToolTip="Сохранить документ как PDF"
                    Padding="8,4"
                    Margin="4,0"/>
            <Button Content="🖨️ Печать" 
                    Click="Print_Click"
                    ToolTip="Открыть диалог печати"
                    Padding="8,4"
                    Margin="4,0"/>
            <Button Content="🗑️ Очистить" 
                    Command="{Binding ClearCommand}"
                    ToolTip="Очистить редактор"
                    Padding="8,4"
                    Margin="4,0"/>
        </ToolBar>

        <!-- Дерево объектов (слева) -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок панели дерева -->
            <Border Grid.Row="0" Background="#F0F0F0" Padding="5,3">
                <TextBlock Text="📁 Объекты" FontWeight="Bold" FontSize="12"/>
            </Border>
            
            <!-- Поиск -->
            <TextBox Grid.Row="0" Margin="50,3,3,3" 
                     Text="{Binding TreeSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Поиск объектов"/>
            
            <!-- TreeView объектов -->
            <TreeView Grid.Row="1"
                      x:Name="ObjectsTreeView"
                      ItemsSource="{Binding RootNodes}"
                      SelectedItemChanged="ObjectsTreeView_SelectedItemChanged"
                      VirtualizingStackPanel.IsVirtualizing="True">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Image Source="{StaticResource FileIcon}" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Name}" Margin="2,0"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Добавить атрибуты в редактор"
                                  Click="AddAttributesToEditor_Click">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource FileIcon}" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Копировать имя"
                                  Click="CopyName_Click">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource CopyIcon}" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
        </Grid>

        <!-- Разделитель 1 -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="5" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="LightGray"/>

        <!-- Live Markdown Editor (объединяет редактирование и просмотр) -->
        <views:LiveMarkdownEditor Grid.Row="1" Grid.Column="2"
                                  Grid.ColumnSpan="3"
                                  x:Name="LiveEditor"
                                  MarkdownText="{Binding MarkdownText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditMode="{Binding IsEditMode}"/>

    </Grid>
</UserControl>
