<UserControl x:Class="PilotMarkdownModule.Views.ObjectTreeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PilotMarkdownModule.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="300"
             Background="#F5F5F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Иконка обновления -->
        <DrawingImage x:Key="RefreshIcon" RenderOptions.EdgeMode="Aliased">
            <DrawingImage.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <DrawingBrush Stretch="None" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#FF0078D4" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                                        </GeometryDrawing.Pen>
                                        <GeometryDrawing.Geometry>
                                            <PathGeometry FillRule="Nonzero" Figures="M14,8 C14,11.314 11.314,14 8,14 5.5,14 3.35,12.5 2.4,10.4 M2,8 C2,4.686 4.686,2 8,2 10.5,2 12.65,3.5 13.6,5.6" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#FF0078D4">
                                        <GeometryDrawing.Geometry>
                                            <PathGeometry FillRule="Nonzero" Figures="M14,4 L14,8 10,8 Z" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        
        <!-- Иконка файла -->
        <DrawingImage x:Key="FileIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF0078D4">
                        <GeometryDrawing.Geometry>
                            <PathGeometry FillRule="Nonzero" Figures="M3,14L3,14 13,14 13,5.5 8.531,1.031 3,1.031z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <PathGeometry FillRule="Nonzero" Figures="M8,2L8,6 12,6 12,13 4,13 4,2 M9,2.75L9,5 11.25,5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        
        <!-- Иконка копирования -->
        <DrawingImage x:Key="CopyIcon" RenderOptions.EdgeMode="Aliased">
            <DrawingImage.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <DrawingBrush Stretch="None" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#FF0078D4">
                                        <GeometryDrawing.Geometry>
                                            <PathGeometry FillRule="Nonzero" Figures="M5,5 L14,5 14,14 5,14 5,5 Z M3,3 L12,3 12,12 3,12 3,3 Z" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Command="{Binding RefreshCommand}" ToolTip="Обновить дерево объектов">
                <Image Source="{StaticResource RefreshIcon}" Width="16" Height="16"/>
            </Button>
            <Separator/>
            <TextBox x:Name="SearchTextBox"
                     Width="150"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Поиск объектов"/>
        </ToolBar>

        <!-- Дерево объектов -->
        <TreeView Grid.Row="1"
                  x:Name="ObjectsTreeView"
                  ItemsSource="{Binding RootNodes}"
                  SelectedItemChanged="ObjectsTreeView_SelectedItemChanged"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Image Source="{StaticResource FileIcon}" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Name}" Margin="2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <EventSetter Event="ContextMenuOpening" Handler="TreeViewItem_ContextMenuOpening"/>
                    <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить атрибуты в редактор"
                              Click="AddAttributesToEditor_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource FileIcon}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Копировать имя"
                              Click="CopyName_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource CopyIcon}" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>

        <!-- Индикатор загрузки -->
        <Border Grid.Row="1"
                Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="100" Height="10"/>
                <TextBlock Text="Загрузка..." Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
