<UserControl x:Class="PilotMarkdownModule.Views.MarkdownDetailsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tools="clr-namespace:Ascon.Pilot.Theme.Tools;assembly=Ascon.Pilot.Theme"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:converters="clr-namespace:PilotMarkdownModule.Converters"
             xmlns:views="clr-namespace:PilotMarkdownModule.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <tools:SharedResourceDictionary 
                    Source="/Ascon.Pilot.Theme;component/Themes/sharedresources/sharedresources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Конвертеры -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <!-- Вкладка 1: Свойства объекта -->
        <TabItem Header="📋 Свойства объекта">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding ObjectName}" 
                               FontSize="{StaticResource LargeFontSize}"
                               FontWeight="Bold"
                               Foreground="{StaticResource NormalForeground}"
                               Margin="0,0,0,12"/>
                    
                    <!-- Отображение атрибутов объекта -->
                    <ItemsControl ItemsSource="{Binding ObjectAttributes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource NormalForeground}"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Value}"
                                               Foreground="{StaticResource NormalForeground}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Вкладка 2: Markdown предпросмотр/редактирование -->
        <TabItem Header="📝 Markdown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель инструментов -->
                <ToolBar Grid.Row="0">
                    <ToggleButton Content="✏️ Редактирование"
                                  IsChecked="{Binding IsEditMode, Mode=TwoWay}"
                                  ToolTip="Переключить режим редактирования"
                                  Padding="8,4"
                                  Margin="4,0"/>
                    <Separator/>
                    <Button Content="💾 Сохранить"
                            Command="{Binding SaveCommand}"
                            ToolTip="Сохранить изменения в Pilot"
                            Padding="8,4"
                            Margin="4,0"/>
                    <TextBlock Text="{Binding HasUnsavedChanges, StringFormat='{}{0:F}'}"
                               Visibility="Collapsed"/>
                </ToolBar>

                <!-- Область контента -->
                <Grid Grid.Row="1">
                    <!-- Режим редактирования: используем LiveMarkdownEditor с EasyMDE -->
                    <views:LiveMarkdownEditor 
                        x:Name="EditorControl"
                        MarkdownText="{Binding MarkdownContent, UpdateSourceTrigger=PropertyChanged}"
                        IsEditMode="True"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Режим просмотра: WebView2 для HTML -->
                    <wv2:WebView2 x:Name="PreviewWebView"
                                  Visibility="{Binding IsEditMode, Converter={StaticResource InvertedBoolToVisibility}}"
                                  Loaded="PreviewWebView_Loaded"/>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
